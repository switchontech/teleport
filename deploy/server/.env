# Copy to .env and edit before: docker compose up -d --build
# Changing any value here just needs: docker compose up -d  (recreates container, same volume/data)

# ── Networking ────────────────────────────────────────────────────────────────
# Public IP/domain + port that VS machines and browsers will reach this server on.
# Dev:    localhost:3080
# Cloud:  1.2.3.4:3080   or   teleport.example.com:443
PUBLIC_ADDR=10.186.128.148.nip.io:3080

# Host ports to publish (left side of docker-compose port mapping).
# Change these if 3080/3024/3025 are already used on the host.
WEB_PORT=3080
AUTH_PORT=3025
TUNNEL_PORT=3024   # reverse tunnel — VS/nodes MUST be able to reach this or they can't join

# ── Cluster ───────────────────────────────────────────────────────────────────
CLUSTER_NAME=switchon.teleport
NODENAME=rachita_teleport

# Static join token for VS nodes — never expires, keep secret
VS_JOIN_TOKEN=vs-join-token-switchon

# First admin user (created by setup-teleport-dev.sh / create-admin.sh)
ADMIN_USER=rachita

# ── Runtime ───────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Extra flags appended to `teleport start` (e.g. --insecure, --debug)
TELEPORT_EXTRA_ARGS=

